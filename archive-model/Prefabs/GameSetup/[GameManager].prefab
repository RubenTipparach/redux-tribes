      m_Calls: []
  m_text: '<b>Rotation and 3D Ship Movement</b>


    <color=yellow>Yellow Arrows<color=black>
    allow you to change the height elevation of the ship.

    <color=#0066AB><b>Blue
    Ball</b><color=black> rotates the ship with Yaw and Pitch.

    <color=red>Red
    Cone<color=black> lets you roll the ship. Useful for when you want to protect
    certain parts of your ship exposed to enemy fire.


'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
